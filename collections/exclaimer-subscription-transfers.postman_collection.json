        {
          "id": "cf2ca8c9-23f9-4ab9-bcc7-3410c024530d",
          "name": "Initiate Subscription Transfer",
          "request": {
            "name": "Initiate Subscription Transfer",
            "description": {
              "content": "This request initiates a subscription transfer. <p> This is the first half or a two part transfer handshake. See <b>Claim Subscription Transfer</b> for the second half of the process. </p><p> This requests puts the target subscription into a state of transfer until it gets claimed. The request returns a Transfer Token that may be used by another consumer to take ownership of the subscription. </p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "1.0",
                "subscriptions",
                ":SubscriptionID",
                "transfer"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "SubscriptionID",
                  "description": "(Required) Your reference for the subscription. This is the same ID you specified, or was automatically generated, when the subscription was created, i.e., when calling <b>Add Subscription</b>."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
